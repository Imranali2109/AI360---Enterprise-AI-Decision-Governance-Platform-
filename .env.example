# AI360 — Environment Variables
# Copy this file to .env and fill in your values

# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/ai360"

# ─── Authentication ──────────────────────────────────────────────────────────
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV="development"
FRONTEND_URL="http://localhost:5173"

# ─── File Upload ─────────────────────────────────────────────────────────────
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10

# ─── AI APIs (Optional — app works in Demo Mode without these) ───────────────
# OpenAI
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"
OPENAI_EMBEDDING_MODEL="text-embedding-ada-002"

# Google Gemini
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-pro"

# Anthropic Claude
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# ─── Demo Mode ───────────────────────────────────────────────────────────────
# Set to "true" to force demo mode even if API keys are present
FORCE_DEMO_MODE="false"
